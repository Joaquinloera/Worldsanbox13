{
  "id": "america-gov",
  "name": "America.gov",
  "type": "government-information-gateway",
  "enabled": true,
  "baseUrl": "https://america.gov",
  "operator": "U.S. General Services Administration",
  "role": {
    "disasterFeed": false,
    "governmentInformationDiscovery": true,
    "sourceDiscovery": true,
    "emergencyGuidanceDiscovery": true
  },
  "sandboxIntegration": {
    "project": "Worldsandbox13",
    "module": "disaster-sandbox",
    "hazards": [
      "earthquake",
      "tsunami",
      "tornado",
      "volcano",
      "microburst"
    ],
    "pipeline": [
      "user-query",
      "government-information-discovery",
      "authoritative-source-link",
      "hazard-normalizer",
      "world-sandbox-ui"
    ]
  },
  "accessPolicy": {
    "publicInformationOnly": true,
    "automatedScraping": false,
    "securityProbing": false,
    "credentialDiscovery": false,
    "bypassAccessControls": false,
    "respectRateLimits": true
  },
  "sourcePriority": [
    "FEMA",
    "USGS",
    "NOAA",
    "NWS",
    "Tsunami.gov",
    "Smithsonian Global Volcanism Program"
  ],
  "credentials": {
    "committedToRepository": false,
    "storage": "environment-variables-only"
  },
  "metadata": {
    "officialSourceRequired": true,
    "displaySourceLinks": true,
    "verifyBeforeEmergencyAction": true
  }
}
