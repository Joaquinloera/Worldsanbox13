{
  "schemaVersion": "1.1.0",
  "registry": {
    "id": "global-shipping-agriculture-registry",
    "name": "Global Shipping, Agriculture & Transportation Registry",
    "mode": "sandbox",
    "defaultStatus": "directory_only"
  },
  "statuses": {
    "directory_only": {
      "connected": false,
      "controlEnabled": false,
      "description": "Directory and public-information record only."
    },
    "integration_available": {
      "connected": false,
      "controlEnabled": false,
      "description": "Authorized integration may be configured."
    },
    "live_connected": {
      "connected": true,
      "controlEnabled": false,
      "description": "Authorized live-data integration is active."
    }
  },
  "sectors": [
    {
      "sectorId": "global-maritime-shipping",
      "name": "Global Maritime Shipping & Ports",
      "category": "maritime",
      "scope": "global",
      "status": "directory_only",
      "systems": [
        "cargo-ships",
        "container-ships",
        "bulk-carriers",
        "tankers",
        "refrigerated-shipping",
        "ports",
        "container-terminals",
        "shipping-lanes",
        "canals",
        "commercial-vessels"
      ],
      "capabilities": {
        "portDirectory": true,
        "publicVesselInformation": true,
        "publicShippingRoutes": true,
        "publicPortStatus": true,
        "privateCargoData": false,
        "vesselControl": false,
        "portControl": false
      }
    },
    {
